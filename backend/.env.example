# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
# Runtime role is mqi_app: full DML, no DDL, so a leaked app credential cannot
# alter the schema. Migrations use mqi_migrator instead.
#
# Use Neon's POOLED host (the one with -pooler in it) for the app -- the direct
# endpoint's connection cap is low on the free tier.
# See backend/db/ACCESS.md.
DATABASE_URL=postgresql://mqi_app:REPLACE_ME@ep-xxxx-pooler.REGION.aws.neon.tech/mqi_project?sslmode=require
PORT=3000
