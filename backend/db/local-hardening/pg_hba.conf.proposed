# Proposed replacement for /opt/homebrew/var/postgresql@17/pg_hba.conf
# Back up the current file before installing this.
#
# Two changes vs today: `trust` -> `scram-sha-256` everywhere, and remote
# access is granted ONLY to mqi_project. The other databases on this cluster
# (learning_platform, nobiai, tableau_rag, postgres) have no `host` rule for a
# non-loopback address, so they stay unreachable from the network.
#
# `+mqi_read` matches any member of that group, directly or transitively --
# which is every role created by db/01-roles.sql. Adding a developer needs no
# pg_hba edit and no reload.

# TYPE     DATABASE      USER         ADDRESS           METHOD

# --- local unix socket + loopback: password required ---
local      all           all                            scram-sha-256
host       all           all          127.0.0.1/32      scram-sha-256
host       all           all          ::1/128           scram-sha-256

# --- teammates on the LAN: mqi_project only, TLS required ---
# hostssl (not host) means a non-TLS attempt is refused outright rather than
# silently downgraded, so passwords never cross the wire in the clear.
hostssl    mqi_project   +mqi_read    192.168.1.0/24    scram-sha-256

# --- replication: loopback only ---
local      replication   all                            scram-sha-256
host       replication   all          127.0.0.1/32      scram-sha-256
host       replication   all          ::1/128           scram-sha-256

# Anything not matched above is rejected by default.
